{
    "buildBodyTr": {
        "tagName": "tr",
        "attributes": {
            "class": "align-middle"
        },
        "children": []
    },
    "buildColGroup": {
        "tagName": "col",
        "attributes": {
            "width": "${width}"
        }
    },
    "buildHeader": {
        "tagName": "th",
        "textContent": "${columnName}",
        "attributes": {
            "class": "py-3 px-3 fw-semibold text-uppercase small"
        }
    },
    "buildFooter": {
        "tagName": "td",
        "children": [
            {
                "tagName": "input",
                "attributes": {
                    "type": "text",
                    "placeholder": "enter ${columnName}",
                    "name": "${columnName}",
                    "id": "${columnName}",
                    "list": "${columnName}",
                    "class": "form-control"
                }
            }
        ]
    },
    "buildBodyCell": {
        "tagName": "td",
        "textContent": "${rowValue}",
        "attributes": {
            "class": "py-3 px-3 text-secondary"
        }
    },
    "button": {
        "tagName": "button",
        "textContent": "${columnName}",
        "attributes": {
            "class": "btn btn-primary btn-sm"
        }
    },
    "buttonCell": {
        "tagName": "td",
        "attributes": {
            "class": "py-2 px-3 text-center"
        },
        "children": [
            {
                "tagName": "button",
                "textContent": "${agg:count}",
                "attributes": {
                    "class": "btn btn-primary btn-sm"
                }
            }
        ]
    },
    "optionsButtonCell": {
        "tagName": "td",
        "attributes": {
            "class": "py-2 px-3 text-center"
        },
        "children": [
            {
                "tagName": "button",
                "textContent": "show",
                "attributes": {
                    "class": "btn btn-primary btn-sm ks-btn-show"
                }
            }
        ]
    },
    "buildOption": {
        "tagName": "option",
        "textContent": "${rowValue}",
        "attributes": {
            "value": "${rowValue}"
        }
    },
    "buildSelect": {
        "tagName": "select",
        "attributes": {
            "id": "${columnName}",
            "name": "${columnName}",
            "data-name": "${columnName}",
            "class": "form-select shadow-sm mb-3"
        },
        "children": []
    },
    "buildDataList": {
        "tagName": "datalist",
        "attributes": {
            "id": "${columnName}",
            "data-name": "${columnName}"
        },
        "children": []
    },
    "buildFormField": {
        "tagName": "div",
        "attributes": {
            "class": "mb-3"
        },
        "children": [
            {
                "tagName": "label",
                "textContent": "${columnName}",
                "attributes": {
                    "for": "${columnName}",
                    "class": "form-label fw-semibold text-capitalize"
                }
            },
            {
                "tagName": "input",
                "attributes": {
                    "type": "text",
                    "id": "${columnName}",
                    "name": "${columnName}",
                    "placeholder": "Enter ${columnName}...",
                    "class": "form-control"
                }
            }
        ]
    },
    "emptyCell": {
        "tagName": "td",
        "children": []
    },
    "headerSerialCell": {
        "tagName": "th",
        "textContent": "#",
        "attributes": {
            "class": "py-3 px-3 fw-semibold text-uppercase small"
        }
    },
    "colGroupForSerial": {
        "tagName": "col",
        "attributes": {
            "width": "50px"
        }
    },
    "colGroupForOption": {
        "tagName": "col",
        "attributes": {
            "width": "100px"
        }
    },
    "headerForOption": {
        "tagName": "th",
        "textContent": "options",
        "attributes": {
            "class": "py-3 px-3 fw-semibold text-uppercase small"
        }
    },
    "tdWithButtonSaveWarning": {
        "tagName": "td",
        "attributes": {
            "class": "py-2 px-3 text-center"
        },
        "children": [
            {
                "tagName": "button",
                "textContent": "save",
                "attributes": {
                    "class": "btn btn-warning btn-sm ks-btn-save"
                }
            }
        ]
    },
    "tableSearch": {
        "tagName": "div",
        "attributes": {
            "class": "row mb-3 justify-content-end"
        },
        "children": [
            {
                "tagName": "div",
                "attributes": {
                    "class": "col-md-4"
                },
                "children": [
                    {
                        "tagName": "div",
                        "attributes": {
                            "class": "input-group"
                        },
                        "children": [
                            {
                                "tagName": "span",
                                "attributes": {
                                    "class": "input-group-text bg-white"
                                },
                                "children": [
                                    {
                                        "tagName": "i",
                                        "attributes": {
                                            "class": "bi bi-search"
                                        },
                                        "textContent": "🔍"
                                    }
                                ]
                            },
                            {
                                "tagName": "input",
                                "attributes": {
                                    "type": "text",
                                    "id": "tableSearch",
                                    "class": "form-control",
                                    "placeholder": "Search table..."
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "tableWithSearch": {
        "tagName": "div",
        "attributes": {
            "data-role": "table-parent",
            "id": "table-simple-id"
        },
        "children": [
            {
                "tagName": "div",
                "attributes": {
                    "class": "row mb-3 align-items-center"
                },
                "children": [
                    {
                        "tagName": "div",
                        "attributes": {
                            "class": "col-md-4 d-flex align-items-center"
                        },
                        "children": [
                            {
                                "tagName": "h6",
                                "attributes": {
                                    "class": "mb-0 fw-semibold text-secondary",
                                    "id": "table-title"
                                },
                                "textContent": "Items"
                            }
                        ]
                    },
                    {
                        "tagName": "div",
                        "attributes": {
                            "class": "col-md-4 text-center d-flex align-items-center justify-content-center"
                        },
                        "children": [
                            {
                                "tagName": "span",
                                "attributes": {
                                    "id": "search-feedback",
                                    "class": "badge bg-white text-secondary border px-3 py-2 small fw-normal shadow-sm"
                                },
                                "textContent": "Showing all records"
                            }
                        ]
                    },
                    {
                        "tagName": "div",
                        "attributes": {
                            "class": "col-md-4"
                        },
                        "children": [
                            {
                                "tagName": "div",
                                "attributes": {
                                    "class": "input-group"
                                },
                                "children": [
                                    {
                                        "tagName": "span",
                                        "attributes": {
                                            "class": "input-group-text bg-white"
                                        },
                                        "children": [
                                            {
                                                "tagName": "i",
                                                "attributes": {
                                                    "class": "bi bi-search"
                                                },
                                                "textContent": "🔍"
                                            }
                                        ]
                                    },
                                    {
                                        "tagName": "input",
                                        "attributes": {
                                            "type": "text",
                                            "id": "tableSearch",
                                            "class": "form-control",
                                            "placeholder": "Search table..."
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "tagName": "div",
                "attributes": {
                    "id": "table-content-container"
                },
                "children": [
                    {
                        "tagName": "table",
                        "attributes": {
                            "class": "table table-hover table-striped align-middle border mb-0",
                            "id": "table-simple-table-id"
                        },
                        "children": [
                            {
                                "tagName": "colgroup",
                                "attributes": {
                                    "data-role": "table-colgroup",
                                    "id": "table-simple-colgroup-id"
                                },
                                "children": []
                            },
                            {
                                "tagName": "thead",
                                "attributes": {
                                    "class": "table-dark",
                                    "data-role": "table-header",
                                    "id": "table-simple-header-id"
                                },
                                "children": [
                                    {
                                        "tagName": "tr",
                                        "attributes": {
                                            "data-role": "table-header-row",
                                            "id": "table-simple-header-row-id"
                                        },
                                        "children": []
                                    }
                                ]
                            },
                            {
                                "tagName": "tbody",
                                "attributes": {
                                    "data-role": "table-body",
                                    "id": "table-simple-body-id"
                                },
                                "children": []
                            },
                            {
                                "tagName": "tfoot",
                                "attributes": {
                                    "data-role": "table-footer",
                                    "id": "table-simple-footer-id"
                                },
                                "children": [
                                    {
                                        "tagName": "tr",
                                        "attributes": {
                                            "data-role": "table-footer-row",
                                            "id": "table-simple-footer-row-id"
                                        },
                                        "children": []
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
