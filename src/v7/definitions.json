  "searchInput": {
    "base": {
      "tagName": "div",
      "attributes": {
        "class": "d-flex align-items-center gap-2",
        "id": "searchInputWrapper"
      },
      "children": [
        {
          "tagName": "label",
          "textContent": "${label}",
          "attributes": {
            "class": "form-label mb-0 text-nowrap fw-semibold",
            "for": "${id}"
          }
        },
        {
          "tagName": "input",
          "attributes": {
            "type": "search",
            "placeholder": "${placeholder}",
            "class": "form-control",
            "id": "${id}"
          }
        }
      ]
    },
    "single": [],
    "double": []
  },
  "form": {
    "base": {
      "tagName": "div",
      "attributes": {
        "class": "card shadow-sm border-0",
        "id": "formCard"
      },
      "children": [
        {
          "tagName": "div",
          "attributes": {
            "class": "card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center",
            "id": "formCardHeader"
          },
          "children": [
            {
              "tagName": "h2",
              "textContent": "${title}",
              "attributes": {
                "class": "h5 fw-bold mb-0 text-dark"
              }
            }
          ]
        },
        {
          "tagName": "div",
          "attributes": {
            "class": "card-body p-4",
            "id": "formCardBody"
          },
          "children": [
            {
              "tagName": "form",
              "attributes": {
                "id": "${formId}",
                "data-role": "form-body"
              },
              "children": []
            }
          ]
        }
      ]
    }
