{
    "buildColgroup": {
        "type": "single",
        "narration": "Build column widths",
        "destinationPath": {
            "fileName": "base",
            "filePath": [
                "children"
            ],
            "jsonPath": "$..*[?@.attributes['data-role'] == 'table-colgroup']"
        },
        "sourcePath": {
            "fileName": "data",
            "jsonPath": "$.columns"
        },
        "templateKey": "buildColGroup",
        "func": "fromCollection"
    },
    "buildHeader": {
        "type": "single",
        "narration": "Build table header",
